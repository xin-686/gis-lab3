{
  "version": 8,
  "name": "China OSM Basemap",
  "center": [104.1954, 35.8617],
  "zoom": 3,
  "sources": {
    "china-osm": {
      "type": "vector",
      "url": "http://localhost:8080/data/china.json"
    }
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4f0" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "china-osm",
      "source-layer": "water",
      "paint": { "fill-color": "#a0c8f0" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "china-osm",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e8e0d8", "fill-opacity": 0.6 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "china-osm",
      "source-layer": "park",
      "paint": { "fill-color": "#c8e6c0", "fill-opacity": 0.7 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "china-osm",
      "source-layer": "building",
      "paint": { "fill-color": "#d4c8b8", "fill-opacity": 0.5 }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "china-osm",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "motorway"]],
      "paint": { "line-color": "#e89a80", "line-width": 2 }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "china-osm",
      "source-layer": "transportation",
      "filter": ["all", ["!=", ["get", "class"], "motorway"]],
      "paint": { "line-color": "#f0e0d0", "line-width": 1 }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "china-osm",
      "source-layer": "place",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": { "text-color": "#444", "text-halo-color": "#fff", "text-halo-width": 1 }
    }
  ]
}
